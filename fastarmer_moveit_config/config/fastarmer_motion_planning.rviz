Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Reference Frame: base_link
    - Class: moveit_rviz_plugin/MotionPlanning
      Name: MotionPlanning
      Enabled: true
      Robot Description: robot_description
      Planning Group: arm
      Planned Path:
        Show Robot Collision: false
        Show Robot Visual: true
  Global Options:
    Fixed Frame: base_link
  Tools:
    - Class: rviz/Interact
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 2.0
      Focal Point: {X: 0.0, Y: 0.0, Z: 0.2}
      Pitch: 0.5
      Yaw: 0.8
