<launch>
  <arg name="exp_param_file" value="$(find remani_planner)/config/exp0_param.yaml"/>
  <arg name="mm_param_file" value="$(find remani_planner)/config/mm_param_ir100_cr5.yaml"/>
  <arg name="planner_param_file" value="$(find remani_planner)/config/remani_planner_param_manual.yaml"/>

  <include file="$(find remani_planner)/launch/run_in_sim.launch">
    <arg name="exp_param_file" value="$(arg exp_param_file)"/>
    <arg name="mm_param_file" value="$(arg mm_param_file)"/>
    <arg name="planner_param_file" value="$(arg planner_param_file)"/>
  </include>

  <node name="rviz" pkg="rviz" type="rviz" args="-d $(find remani_planner)/launch/exp0.rviz"/>
</launch>
