<launch>
  <arg name="pcd_file"
       default="$(find remani_planner)/../../scans_bottom_xyzRemove_filtered/scansdibu_xyzRemove_filtered_1cm.pcd"/>
  <!-- A static world-frame PCD must enter GridMap through the global-map
       callback on /map_generator/global_cloud, not through the body-frame
       depth/cloud fusion topic /pcl_render_node/cloud. -->
  <arg name="pcd_topic" default="/map_generator/global_cloud"/>
  <arg name="voxel_leaf_size" default="0.0"/>
  <!-- Default placement centres the locomotive cloud roughly 3 m in front of
       the robot and inside the 20x8x3 m map.  Adjust for the real setup. -->
  <arg name="twc_tx" default="-7.9"/>
  <arg name="twc_ty" default="7.05"/>
  <arg name="twc_tz" default="0.5"/>
  <arg name="twc_roll" default="0.0"/>
  <arg name="twc_pitch" default="0.0"/>
  <arg name="twc_yaw" default="0.0"/>
  <!-- Cloud interactive placement is disabled here so RViz 2D Pose Estimate
       initializes the mobile base instead of moving the cloud. -->
  <arg name="pose_topic" default=""/>
  <!-- Startup placement [x, y, z, yaw]; [] keeps T_world_cloud.  Saved by
       save_pcd_pose.sh and replayed by run_pcd_demo.sh. -->
  <arg name="initial_pose" default="[]"/>
  <!-- The real locomotive cloud spans several metres; allow a larger world so
       far goals beyond the cloud remain inside the planner's map. -->
  <arg name="map_size_x" default="60.0"/>
  <arg name="map_size_y" default="50.0"/>
  <arg name="map_size_z" default="3.0"/>

  <!-- Reuse the complete IR100+CR10 simulator/planner/RViz launch, but do
       not start the synthetic test-bar map.  global_map_refresh lets every
       re-published cloud rebuild the world map so 2D Pose Estimate moves the
       locomotive interactively. -->
  <include file="$(find remani_planner)/launch/exp0_ir100_cr10_manual.launch">
    <arg name="load_map" value="false"/>
    <arg name="global_map_refresh" value="true"/>
    <!-- Known static map: keep a tight inflation so the raised undercarriage
         still leaves room for the folded manipulator. -->
    <arg name="obstacles_inflation" value="0.0"/>
    <!-- Give the coupled arm search enough time to fold the arm through. -->
    <arg name="override_planner_profile" value="true"/>
    <!-- Allow detours around the locomotive (<=0 disables the straight
         start->goal lateral corridor inherited from the bar scenario). -->
    <arg name="profile_lateral_corridor" value="0.0"/>
    <arg name="profile_poly_piece_length" value="0.15"/>
    <arg name="profile_max_mani_search_time" value="25.0"/>
    <arg name="profile_max_loop_num" value="30000"/>
    <!-- Long coupled paths contain hundreds of nodes; the oneShot shortcut is
         O(n^2..3) in the path length, so bound its stride and jump depth. -->
    <arg name="profile_oneshot_stride" value="8"/>
    <arg name="profile_oneshot_max_jump_layers" value="10"/>
    <!-- Denser front-end collision sampling so the RRT seed itself avoids the
         locomotive cloud (the 10 ms final gate otherwise finds misses). -->
    <arg name="profile_rrt_collision_pos_resolution" value="0.005"/>
    <arg name="profile_rrt_collision_joint_resolution" value="0.005"/>
    <arg name="profile_rrt_collision_min_checks" value="20"/>
    <arg name="map_size_x" value="$(arg map_size_x)"/>
    <arg name="map_size_y" value="$(arg map_size_y)"/>
    <arg name="map_size_z" value="$(arg map_size_z)"/>
  </include>

  <!-- T_world_cloud maps the PCD frame onto world; the PCD file is never
       rewritten.  Optionally voxel-downsample the environment cloud. -->
  <node pkg="remani_planner" type="static_pcd_publisher.py"
        name="static_pcd_publisher" output="screen">
    <param name="pcd_file" value="$(arg pcd_file)"/>
    <param name="frame_id" value="world"/>
    <param name="topic" value="$(arg pcd_topic)"/>
    <param name="rate" value="1.0"/>
    <param name="pose_topic" value="$(arg pose_topic)"/>
    <param name="initial_pose" type="yaml" value="$(arg initial_pose)"/>
    <param name="voxel_leaf_size" value="$(arg voxel_leaf_size)"/>
    <param name="T_world_cloud/translation" type="yaml"
           value="[$(arg twc_tx), $(arg twc_ty), $(arg twc_tz)]"/>
    <param name="T_world_cloud/rpy" type="yaml"
           value="[$(arg twc_roll), $(arg twc_pitch), $(arg twc_yaw)]"/>
  </node>
</launch>
